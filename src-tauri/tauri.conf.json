{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "PixPDF X",
  "version": "1.0.0",
  "identifier": "com.naviki.pixpdf-x",
  "build": {
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build",
    "devUrl": "http://localhost:5173",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "PixPDF X",
        "width": 1440,
        "height": 900,
        "minWidth": 1024,
        "minHeight": 768,
        "center": true,
        "decorations": true,
        "transparent": false,
        "fullscreen": false,
        "resizable": true,
        "theme": "Dark"
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' asset: https://asset.localhost; style-src 'self' 'unsafe-inline'",
      "assetProtocol": {
        "enable": true,
        "scope": ["$APPDATA/**", "$TEMP/**", "**"]
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "resources": [],
    "copyright": "© 2024 NAVIKI Labs. All rights reserved.",
    "category": "Productivity",
    "shortDescription": "Next Generation PDF Studio",
    "longDescription": "Professional PDF editing, conversion, and management powered by NAVIKI Labs."
  },
  "plugins": {
    "shell": {
      "open": true
    }
  }
}
